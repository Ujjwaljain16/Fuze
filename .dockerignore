# Never needed inside the image -- the Dockerfile COPYs only specific
# paths (backend/, wsgi.py, app.py, start.sh, supervisord.conf, alembic.ini,
# requirements.txt), but without this file the full repo (including the
# directories below) is still eligible to be scanned/hashed as build context.
.git/
frontend/
BookmarkExtension/
venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
.ruff_cache/
.kombai/
.vscode/
interview/
docs/
scripts/
**/*.log
**/*.pem
**/.env
**/.env.*

# Local-only working files under backend/ (gitignored, but `COPY backend/` would still
# bake them into the image): scratch scripts can hold live credentials, logs hold JWTs.
backend/scratch/
backend/brain/
backend/instance/
backend/tests/
backend/eval/
backend/*.txt
image.png
index.html
sw.html
