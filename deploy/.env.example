# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Public hostname Caddy serves over HTTPS (e.g. a free DuckDNS name pointing at the VM's IP)
DOMAIN=api.example.com

# production, development or testing. Unset means production (core/app_env.py), which
# refuses to start with missing or default secrets.
APP_ENV=production
# Only labels log lines; APP_ENV above is what decides behaviour.
ENVIRONMENT=production
DEBUG=false

# When migrating an existing deployment these MUST be the values it used: SECRET_KEY (or
# API_KEY_ENCRYPTION_KEY, if set) decrypts stored per-user API keys, and JWT_SECRET_KEY keeps
# existing login sessions valid. At least 16 characters, not a published default.
SECRET_KEY=
JWT_SECRET_KEY=
# Optional: encrypts stored API keys instead of SECRET_KEY (see docs/OPERATIONS.md, Secrets).
API_KEY_ENCRYPTION_KEY=

DATABASE_URL=
DB_SSL_MODE=require
# Required in production (rate limiting and the job queue). Use rediss:// (TLS) for hosted Redis
# such as Upstash.
REDIS_URL=

# Shared Gemini key for users who have not added their own (SYSTEM_GEMINI_DAILY_LIMIT_PER_USER
# uses per user per day, default 30).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Optional: send every LLM call (page analysis, Ask, intents) to an OpenAI-compatible provider
# instead of Gemini. LLM_BASE_URL, LLM_API_KEY and LLM_MODEL are all required when it is on
# (see docs/OPERATIONS.md, LLM provider).
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://llm.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_FALLBACK_MODEL=
# LLM_JSON_MODE=false
# LLM_MAX_TOKENS=4096

# Origins allowed to call the API with credentials (exact origins, no wildcards), comma separated.
# Include the frontend's origin.
CORS_ORIGINS=https://app.example.com

# Google sign-in through Supabase Auth (docs/SUPABASE_GOOGLE_OAUTH.md). Without these the
# Google endpoints answer 503.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
