# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Public hostname Caddy serves over HTTPS (e.g. a free DuckDNS name pointing at the VM's IP)
DOMAIN=fuze-api.duckdns.org

ENVIRONMENT=production
FLASK_ENV=production
DEBUG=false

# MUST be the same values the previous deployment used: SECRET_KEY decrypts stored
# per-user API keys, JWT_SECRET_KEY keeps existing login sessions valid.
SECRET_KEY=
JWT_SECRET_KEY=

DATABASE_URL=
DB_SSL_MODE=require
# Use rediss:// (TLS) for Upstash
REDIS_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

CORS_ORIGINS=https://itsfuze.vercel.app,http://localhost:5173,http://localhost:3000

SUPABASE_URL=https://xqfgfalwwfwtzvuuvroq.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_TABLE=saved_content
SUPABASE_BOOKMARKS_TABLE=saved_content

# No browser automation in the image; plain-HTTP scraping only
DISABLE_BROWSER_FETCHERS=true
