# ==============================================================================
# FUZE - UNIFIED CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values
# All values shown are defaults - only override what you need

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# development | testing | production. Unset means production: the app then refuses
# to start without strong SECRET_KEY / JWT_SECRET_KEY. ENVIRONMENT and FLASK_ENV are
# still read as fallbacks.
APP_ENV=development
DEBUG=true
# Port the web process listens on when started directly (python backend/wsgi.py). The Docker image sets 7860.
PORT=5000
# Run "alembic upgrade head" when the app boots. Off unless exactly "true": start.sh already migrates
# once before the web workers start, and enabling this too would run the migration in each of them.
AUTO_MIGRATE_ON_BOOT=false

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/fuze
# Per process. Web (gunicorn) workers use DB_POOL_SIZE/DB_MAX_OVERFLOW, RQ workers the
# DB_WORKER_* pair. All processes together must stay under the database pooler's limit:
# see docs/OPERATIONS.md, "Database connections".
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_WORKER_POOL_SIZE=2
DB_WORKER_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true
DB_ECHO=false
DB_CONNECT_TIMEOUT=5
# Server-side limit for one query in milliseconds, so a stuck query cannot hold a connection for long.
DB_STATEMENT_TIMEOUT_MS=15000
# With DB_POOL_PRE_PING on, a pooled connection is checked (SELECT 1) only after sitting idle this
# many seconds. 0 checks on every checkout.
DB_PING_IDLE_SECONDS=15
# Leave unset: 'require' in production, 'prefer' elsewhere.
# DB_SSL_MODE=require

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Full connection URL. When set it takes precedence over REDIS_HOST/PORT/DB/PASSWORD below.
# redis:// is plain text; rediss:// is TLS and is verified against the system CA bundle.
# (redis:// URLs on upstash.io are upgraded to rediss:// automatically.)
REDIS_URL=redis://localhost:6379/0
# Used only when REDIS_URL is empty.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Use TLS with REDIS_HOST/PORT (not needed with a rediss:// REDIS_URL). Turned on automatically
# for upstash.io, redislabs.com and redis.cache hosts.
REDIS_SSL=false
# Skip TLS certificate and hostname checks. Leave false except to get past a provider with a broken
# certificate chain: it makes the connection open to interception.
REDIS_ALLOW_UNVERIFIED_SSL=false

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================
SECRET_KEY=change-this-in-production-to-a-random-string
JWT_SECRET_KEY=change-this-in-production-to-a-random-string
# Optional (16+ characters). Encrypts users' stored Gemini keys instead of SECRET_KEY, so
# SECRET_KEY can be rotated without losing them. Keys saved earlier stay readable and are
# re-encrypted with this one when next used. Keep it stable: losing it loses those keys.
API_KEY_ENCRYPTION_KEY=
JWT_ACCESS_TOKEN_EXPIRES_HOURS=1
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# A refresh token presented again this soon after rotating gets the same new pair back (a lost
# response or two tabs racing) instead of ending the session as token reuse. 0 disables it.
REFRESH_GRACE_SECONDS=60
# bcrypt cost for new password hashes (log2 rounds). Each +1 doubles the time one login takes.
# BCRYPT_LOG_ROUNDS=12
# Secret for the hash that identifies revoked API keys in Redis. Unset: derived from SECRET_KEY.
# Changing it makes earlier revocations stop matching.
# REVOCATION_SECRET=
# When Redis is down the revocation check cannot run: true accepts the key (the API stays up),
# false rejects every key until Redis is back.
REVOCATION_FAIL_OPEN=true
# Token for the detailed health response (queue depth, cache stats); callers send it as the
# X-Internal-Token header. Unset or empty: the detail is never shown. Use a long random value.
# INTERNAL_HEALTH_TOKEN=
# Google sign-in through Supabase Auth (docs/SUPABASE_GOOGLE_OAUTH.md). Without SUPABASE_URL the
# Google endpoints answer 503.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=

# ==============================================================================
# EMBEDDINGS AND SEARCH
# ==============================================================================
# Must be a 384-d model; production bakes BAAI/bge-small-en-v1.5 into the image.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Re-order the top search hits with a cross-encoder. Off by default: it changed result quality by
# less than 0.01 nDCG@10 and added about 700 ms per query on CPU. Turning it on needs the model
# in the image (see the Dockerfile).
SEARCH_RERANK_ENABLED=false
SEARCH_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Mark recommendations the same cross-encoder does not tie to the current project or task as "weak matches"
# (the page folds them away; the order does not change). About 0.3 s per request; the model is baked into the image.
RECOMMENDATION_CONFIDENCE_ENABLED=true

# Page fetching: LinkedIn posts a user saves are read with one plain request for the post's public page. LinkedIn's
# robots.txt forbids this, so it is a deliberate, documented exception (docs/CONTENT_ACQUISITION.md); set to false
# and those links are refused by robots.txt like any other disallowed site.
LINKEDIN_PUBLIC_FETCH_ENABLED=true

# ==============================================================================
# AI SERVICES CONFIGURATION
# ==============================================================================
GEMINI_API_KEY=your-gemini-api-key-here
# Users without their own key share GEMINI_API_KEY, up to this many uses a day each.
SYSTEM_GEMINI_DAILY_LIMIT_PER_USER=30
# Request bodies above this many bytes get a 413.
MAX_REQUEST_BYTES=5242880
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1024
GEMINI_TIMEOUT=30

# --- Optional: an OpenAI-compatible LLM provider instead of Gemini (CloseRouter, OpenRouter, a local
# server). When LLM_PROVIDER=openai_compat, EVERY LLM call in this deployment (page analysis, Ask,
# intents, explanations) goes to it and users need no Gemini key. Page text is sent to that provider.
# All of LLM_BASE_URL, LLM_API_KEY and LLM_MODEL are required; set the key as a secret, never in git.
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=vendor/model-name
# LLM_FALLBACK_MODEL=
# Ask for JSON-only replies (response_format). Off by default: not every routed model accepts it.
# LLM_JSON_MODE=false
# Output budget per call. Keep it generous: models that think first spend hundreds of hidden
# reasoning tokens against it, and a low limit cuts the reply off. Only tokens used are billed.
# LLM_MAX_TOKENS=4096
ENABLE_GEMINI=true

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Extra exact origins (comma-separated). The production app, its Vercel previews and, outside
# production, the local dev servers are always allowed. Wildcards are ignored.
CORS_ORIGINS=
# Only if a page inside the extension calls the API without host_permissions.
EXTENSION_ID=
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ==============================================================================
# RETENTION
# ==============================================================================
# Bookmark pipeline audit events (bookmark_events) older than this are deleted once a day by the
# reconciler in the default RQ worker. 0 keeps them forever.
BOOKMARK_EVENTS_RETENTION_DAYS=30

# ==============================================================================
# CONTENT ACQUISITION TIERS (see docs/CONTENT_ACQUISITION.md)
# ==============================================================================
# When our own fetch comes back thin, as a JS shell or as a bot challenge, ask a remote reader
# service (Jina Reader) to render the page. It receives the page URL only; URLs that carry
# secrets (token=, signed links) are never sent. Set to false to keep every fetch in-house.
ENABLE_READER_FALLBACK=true
# Optional free key from jina.ai: raises the limit from 20 requests/min per IP to hundreds.
# Recommended on shared egress IPs (Hugging Face Spaces).
READER_API_KEY=
READER_TIMEOUT_SECONDS=20
# Our own ceiling across all workers. Defaults: 15/min without a key, 300/min with one.
# READER_RPM=
# READER_BASE_URL=https://r.jina.ai/
# For pages that are gone (404/410) or block us, use the latest Wayback Machine snapshot.
# archive.org receives the page URL only. The stored metadata records the snapshot date.
ENABLE_ARCHIVE_FALLBACK=true

# ==============================================================================
# OBSERVABILITY (SENTRY)
# ==============================================================================
# Backend (web + RQ workers): off unless set. The environment is APP_ENV; the release is
# GIT_SHA, or the backend/RELEASE file the HF deploy writes.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Name attached to every structured log line as the "service" field.
# SERVICE_NAME=fuze-api
# Frontend: baked in at build time (Vercel env); off unless set.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ==============================================================================
# PROMETHEUS METRICS
# ==============================================================================
METRICS_ENABLED=true
# Bearer token required by Grafana Cloud agent to scrape /metrics
METRICS_AUTH_TOKEN=change-this-to-a-secure-random-token
# Required for multi-process (gunicorn) mode — set to a writable tmpfs dir
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
FEATURE_FLAGS_CACHE_TTL=5
# Warm the recommendation cache when a user logs in (runtime flag, overridable in Redis)
CACHE_WARM_ON_LOGIN=false
# Seconds a warmed recommendation cache suppresses warming again for the same user.
CACHE_WARM_TTL_RECOMMENDATIONS=300
# Local development without the model download: hash vectors instead of real embeddings.
DISABLE_EMBEDDINGS=false

# ==============================================================================
# PRODUCTION NOTES
# ==============================================================================
# For production deployment:
# 1. Set APP_ENV=production (or leave it unset)
# 2. Set DEBUG=false
# 3. Generate strong SECRET_KEY and JWT_SECRET_KEY
# 4. Use SSL for database (DB_SSL_MODE=require)
# 5. Set proper CORS_ORIGINS (no wildcards)
# 6. Set REDIS_URL (rediss:// for TLS); production rate limiting refuses to start without it
# ==============================================================================
