# ==============================================================================
# FUZE - UNIFIED CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values
# All values shown are defaults - only override what you need

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# development | testing | production. Unset means production: the app then refuses
# to start without strong SECRET_KEY / JWT_SECRET_KEY. ENVIRONMENT and FLASK_ENV are
# still read as fallbacks.
APP_ENV=development
DEBUG=true

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/fuze
# Per process. Web (gunicorn) workers use DB_POOL_SIZE/DB_MAX_OVERFLOW, RQ workers the
# DB_WORKER_* pair. All processes together must stay under the database pooler's limit:
# see docs/OPERATIONS.md, "Database connections".
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_WORKER_POOL_SIZE=2
DB_WORKER_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true
DB_ECHO=false
DB_CONNECT_TIMEOUT=5
# Leave unset: 'require' in production, 'prefer' elsewhere.
# DB_SSL_MODE=require

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=3600
REDIS_MAX_CONNECTIONS=50

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================
SECRET_KEY=change-this-in-production-to-a-random-string
JWT_SECRET_KEY=change-this-in-production-to-a-random-string
# Optional (16+ characters). Encrypts users' stored Gemini keys instead of SECRET_KEY, so
# SECRET_KEY can be rotated without losing them. Keys saved earlier stay readable and are
# re-encrypted with this one when next used. Keep it stable: losing it loses those keys.
API_KEY_ENCRYPTION_KEY=
JWT_ACCESS_TOKEN_EXPIRES_HOURS=1
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# A refresh token presented again this soon after rotating gets the same new pair back (a lost
# response or two tabs racing) instead of ending the session as token reuse. 0 disables it.
REFRESH_GRACE_SECONDS=60
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5

# ==============================================================================
# MACHINE LEARNING CONFIGURATION
# ==============================================================================
# Must be a 384-d model; production bakes BAAI/bge-small-en-v1.5 into the image.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
SPACY_MODEL=en_core_web_sm
ML_LEARNING_RATE=0.05
ML_DECAY_RATE=0.95
TFIDF_MAX_FEATURES=5000
TFIDF_NGRAM_MIN=1
TFIDF_NGRAM_MAX=3
BM25_K1_INITIAL=1.5
BM25_B_INITIAL=0.75
INTERACTION_WEIGHT_DECAY=0.95
MIN_INTERACTIONS_FOR_PERSONALIZATION=5

# ==============================================================================
# RECOMMENDATION ENGINE CONFIGURATION
# ==============================================================================
MAX_RECOMMENDATIONS_DEFAULT=10
MAX_RECOMMENDATIONS_LIMIT=50
MIN_QUALITY_SCORE=0.0
MIN_RELEVANCE_SCORE=0.1
MIN_CONFIDENCE_SCORE=0.3
ENABLE_DIVERSITY=true
DIVERSITY_THRESHOLD=0.7
CACHE_RECOMMENDATIONS=true
CACHE_TTL_SECONDS=1800
MAX_CONTENT_ITEMS_TO_PROCESS=1000
CONTENT_TEXT_MAX_LENGTH=2000

# ==============================================================================
# AI SERVICES CONFIGURATION
# ==============================================================================
GEMINI_API_KEY=your-gemini-api-key-here
# Users without their own key share GEMINI_API_KEY, up to this many uses a day each.
SYSTEM_GEMINI_DAILY_LIMIT_PER_USER=30
# Request bodies above this many bytes get a 413.
MAX_REQUEST_BYTES=5242880
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1024
GEMINI_TIMEOUT=30
ENABLE_GEMINI=true

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Extra exact origins (comma-separated). The production app, its Vercel previews and, outside
# production, the local dev servers are always allowed. Wildcards are ignored.
CORS_ORIGINS=
# Only if a page inside the extension calls the API without host_permissions.
EXTENSION_ID=
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ==============================================================================
# PERFORMANCE CONFIGURATION
# ==============================================================================
ENABLE_QUERY_CACHING=true
ENABLE_EMBEDDING_CACHING=true
ENABLE_PARALLEL_PROCESSING=true
MAX_WORKERS=4
REQUEST_TIMEOUT_SECONDS=30
SLOW_QUERY_THRESHOLD_MS=1000
# Bookmark pipeline audit events (bookmark_events) older than this are deleted once a day by the
# reconciler in the default RQ worker. 0 keeps them forever.
BOOKMARK_EVENTS_RETENTION_DAYS=30

# ==============================================================================
# CONTENT ACQUISITION TIERS (see docs/CONTENT_ACQUISITION.md)
# ==============================================================================
# When our own fetch comes back thin, as a JS shell or as a bot challenge, ask a remote reader
# service (Jina Reader) to render the page. It receives the page URL only; URLs that carry
# secrets (token=, signed links) are never sent. Set to false to keep every fetch in-house.
ENABLE_READER_FALLBACK=true
# Optional free key from jina.ai: raises the limit from 20 requests/min per IP to hundreds.
# Recommended on shared egress IPs (Hugging Face Spaces).
READER_API_KEY=
READER_TIMEOUT_SECONDS=20
# Our own ceiling across all workers. Defaults: 15/min without a key, 300/min with one.
# READER_RPM=
# READER_BASE_URL=https://r.jina.ai/
# For pages that are gone (404/410) or block us, use the latest Wayback Machine snapshot.
# archive.org receives the page URL only. The stored metadata records the snapshot date.
ENABLE_ARCHIVE_FALLBACK=true

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_PATH=
LOG_MAX_FILE_SIZE_MB=10
LOG_BACKUP_COUNT=5
LOG_ENABLE_CONSOLE=true

# ==============================================================================
# OBSERVABILITY (SENTRY)
# ==============================================================================
# Backend (web + RQ workers): off unless set. The environment is APP_ENV; the release is
# GIT_SHA, or the backend/RELEASE file the HF deploy writes.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=1.0.0
# Frontend: baked in at build time (Vercel env); off unless set.
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ==============================================================================
# PROMETHEUS METRICS
# ==============================================================================
METRICS_ENABLED=true
# Bearer token required by Grafana Cloud agent to scrape /metrics
METRICS_AUTH_TOKEN=change-this-to-a-secure-random-token
# Required for multi-process (gunicorn) mode — set to a writable tmpfs dir
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
FEATURE_FLAGS_CACHE_TTL=5
# Warm the recommendation cache when a user logs in (runtime flag, overridable in Redis)
CACHE_WARM_ON_LOGIN=false
# Local development without the model download: hash vectors instead of real embeddings.
DISABLE_EMBEDDINGS=false

# ==============================================================================
# PRODUCTION NOTES
# ==============================================================================
# For production deployment:
# 1. Set APP_ENV=production (or leave it unset)
# 2. Set DEBUG=false
# 3. Generate strong SECRET_KEY and JWT_SECRET_KEY
# 4. Use SSL for database (DB_SSL_MODE=require)
# 5. Set proper CORS_ORIGINS (no wildcards)
# 6. Enable all caching options
# 7. Set appropriate LOG_FILE_PATH
# ==============================================================================
