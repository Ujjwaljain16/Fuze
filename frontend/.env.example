# Frontend environment (Vite). Copy to .env.local for local work; set the same names in your host (Vercel).
# Only variables prefixed VITE_ are exposed to the browser: never put secrets here.

# Backend origin. Local development defaults to http://127.0.0.1:5000.
# In a production build set this to your own backend. If it is missing the build falls back to the
# maintainer's hosted backend (frontend/src/services/api.js), so a fork must set it.
VITE_API_URL=http://127.0.0.1:5000

# Supabase project URL, only needed for "Continue with Google" (see docs/SUPABASE_GOOGLE_OAUTH.md).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Optional error reporting.
# VITE_SENTRY_DSN=
# VITE_ENVIRONMENT=development
